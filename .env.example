# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
SUPABASE_SERVICE_KEY=xxxxx

# Blogger API
BLOGGER_API_KEY=xxxxx
BLOGGER_BLOG_ID=xxxxx
BLOGGER_REFRESH_TOKEN=xxxxx

# Jikan API (libre, no requiere key)
NEXT_PUBLIC_JIKAN_API_URL=https://api.jikan.moe/v4

# TMDB (fallback)
NEXT_PUBLIC_TMDB_API_KEY=xxxxx
TMDB_API_ACCESS_TOKEN=xxxxx

# Cache (Redis - proporcionado por Supabase)
REDIS_URL=redis://xxxxx:6379

# Notificaciones (Discord - opcional)
DISCORD_WEBHOOK_URL=xxxxx

# GitHub Actions (para cron jobs)
GITHUB_TOKEN=xxxxx

# General
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
